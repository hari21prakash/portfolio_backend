# ASP.NET Core does not read .env files natively — this file documents the
# environment variable names to set on your host (Render/Railway) or in a
# local launch profile. Use double underscores (__) for nested config keys.

ConnectionStrings__DefaultConnection=Host=YOUR_DB_HOST;Port=5432;Database=portfolio_db;Username=postgres;Password=1234;SSL Mode=Require;Trust Server Certificate=true

Jwt__Key=REPLACE_WITH_A_LONG_RANDOM_PRODUCTION_SECRET_AT_LEAST_32_CHARS
Jwt__Issuer=PortfolioApi
Jwt__Audience=PortfolioClient
Jwt__ExpiryMinutes=120

Cors__AllowedOrigins__0=https://your-frontend-domain.com

Seed__AdminUsername=admin
Seed__AdminEmail=admin@example.com
Seed__AdminPassword=SetAStrongPasswordHereOnFirstDeployOnly

ASPNETCORE_ENVIRONMENT=Production
